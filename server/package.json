{
  "name": "ys-creations-server",
  "version": "1.0.0",
  "description": "Production backend for YS Creations premium beads eCommerce",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/jobs/seed.js",
    "seed:destroy": "node src/jobs/seed.js --destroy",
    "check": "node scripts/check-syntax.js",
    "test:smoke": "node scripts/smoke.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cloudinary": "2.5.1",
    "compression": "1.7.5",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.9.5",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "pdfkit": "0.15.2",
    "qrcode": "1.5.4",
    "uuid": "11.0.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "10.1.3",
    "nodemon": "3.1.9"
  }
}
