# ── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/ys-creations
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/ys-creations
MONGODB_URI=mongodb://127.0.0.1:27017/ys-creations

# ── Auth / JWT ───────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ── Client (CORS whitelist, comma-separated) ─────────────
# storefront, admin app
CLIENT_URL=http://localhost:5173,http://localhost:5174

# ── Cookies ──────────────────────────────────────────────
COOKIE_DOMAIN=

# ── Cloudinary (media uploads — inert until provided) ────
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# ── Razorpay (Phase 4 — inert until provided) ────────────
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Shiprocket (Phase 4 — inert until provided) ──────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=

# ── Business / invoice details ───────────────────────────
COMPANY_NAME=YS Creations
COMPANY_GSTIN=29ABCDE1234F1Z5

# ── Seed admin (used by `npm run seed`) ──────────────────
SEED_ADMIN_EMAIL=admin@yscreations.com
SEED_ADMIN_PASSWORD=Admin@12345
