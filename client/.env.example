# Frontend environment variables (Vite requires the VITE_ prefix)
# Copy to .env.local and fill in when wiring up later phases.

# Base URL for the Express API (Phase 3). Dev uses the Vite proxy by default.
VITE_API_URL=http://localhost:5000/api

# Razorpay public key (Phase 4)
VITE_RAZORPAY_KEY_ID=

# Cloudinary (if doing unsigned client uploads)
VITE_CLOUDINARY_CLOUD_NAME=
